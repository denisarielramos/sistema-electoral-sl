# Copiar a .env.local y completar con los valores reales. Nunca commitear
# .env.local (ya está en .gitignore vía *.local).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Monitoreo de recorridos (Fase 4): clave de la API de Google Maps JavaScript.
# Sin esta variable, el módulo de Monitoreo de recorridos sigue compilando y
# funcionando normalmente — solo el mapa en vivo/replay muestra un aviso de
# "Google Maps no está configurado" en su lugar.
VITE_GOOGLE_MAPS_API_KEY=
